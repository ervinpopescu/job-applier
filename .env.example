# Container image to deploy. Forks should replace the owner/repository.
JOB_APPLIER_IMAGE=ghcr.io/ervinpopescu/job-applier:latest

# Bind to localhost by default. Use a reverse proxy for HTTPS and authentication.
JOB_APPLIER_BIND_ADDRESS=127.0.0.1
JOB_APPLIER_PORT=8000

# Required for AI resume tailoring and screening answers.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: enables Jooble searches.
JOOBLE_API_KEY=
