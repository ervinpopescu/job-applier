# Container image to deploy. Forks should replace the owner/repository.
JOB_APPLIER_IMAGE=ghcr.io/ervinpopescu/job-applier:latest

# Bind to localhost by default. Use a reverse proxy for HTTPS and authentication.
JOB_APPLIER_BIND_ADDRESS=127.0.0.1
JOB_APPLIER_PORT=8000

# Required for AI resume tailoring and screening answers.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: enables Jooble searches.
JOOBLE_API_KEY=

# Cloudflare Tunnel & Edge Access Configuration (Zero-Trust)
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_ORIGIN=https://jobs.archnet.lol
ALLOWED_HOSTS=jobs.archnet.lol,jobs.aslan.net,aslan.archnet.lol,localhost,127.0.0.1,web,gateway

# Cloudflare Access (Strict RS256 JWT Verification & Exact Identity Allowlist)
CF_ACCESS_ENABLED=false
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_ALLOWED_IDENTITIES=
VIEWER_MAX_DURATION_SECONDS=300

# ntfy Mobile & Offline Alert Notifications
# Default internal service gateway:
NTFY_URL=http://ntfy:80
NTFY_TOPIC=job-alerts
NTFY_TOKEN=

# Phone Alerts Public Fallback (e.g. ntfy.sh direct push to iPhone / Android app):
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=ervin-aslan-cluster-alerts

# Optional Host Fallback Notification Script (runs: script -t <title> -m <message> -p <priority>)
NTFY_FALLBACK_SCRIPT=~/bin/notify-alert.sh
