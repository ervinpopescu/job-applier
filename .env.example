# Container image to deploy. Forks should replace the owner/repository.
JOB_APPLIER_IMAGE=ghcr.io/ervinpopescu/job-applier:latest

# Bind to localhost by default. Use a reverse proxy for HTTPS and authentication.
JOB_APPLIER_BIND_ADDRESS=127.0.0.1
JOB_APPLIER_PORT=8000

# Required for AI resume tailoring and screening answers.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: enables Jooble searches.
JOOBLE_API_KEY=

# --- Dashboard Access Control & OAuth Authentication ---
# Set to 'true' to require Google and/or GitHub OAuth authentication to access the dashboard.
# Defaults to 'false' so local installs run without authentication.
APP_AUTH_ENABLED=false

# Required when APP_AUTH_ENABLED=true: strong random key (at least 32 characters) for signed session cookies.
# Generate with: openssl rand -base64 32
APP_SESSION_SECRET=

# Explicit public origin or reverse proxy base path URL (e.g. https://jobs.example.com or https://example.com/job-applier).
# Used for exact OAuth callback URLs and redirects behind reverse proxies; never trusts arbitrary forwarded Host headers.
APP_PUBLIC_URL=http://127.0.0.1:8000

# Session cookie settings
APP_SESSION_COOKIE_NAME=job_applier_session
APP_SESSION_MAX_AGE=1209600
# APP_SESSION_COOKIE_SECURE=true  # Automatically true when APP_PUBLIC_URL starts with https://

# Google OAuth Configuration (at least one provider required when APP_AUTH_ENABLED=true)
# Callback URL to register in Google Cloud Console: <APP_PUBLIC_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated email allowlist (e.g. user@example.com, admin@example.com)
AUTH_ALLOWED_GOOGLE_EMAILS=

# GitHub OAuth Configuration (at least one provider required when APP_AUTH_ENABLED=true)
# Callback URL to register in GitHub Developer Settings: <APP_PUBLIC_URL>/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional comma-separated username allowlist (e.g. octocat, torvalds)
AUTH_ALLOWED_GITHUB_USERS=
